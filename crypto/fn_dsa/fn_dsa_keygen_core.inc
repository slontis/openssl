/* ePrint 2026/1531, Algorithm 2: pre-solver spectral bounds on f and g. */
static int fn_dsa_bounds_pre(const FN_DSA_REAL *f, const FN_DSA_REAL *g,
                             size_t n)
{
    size_t i, hn = n / 2;
    unsigned bad = 0;
    FN_DSA_REAL fbound = fxr_of(255 * 255),
                lower = fxr_div(fxr_of(12289), fxr_of(16)),
                upper = fxr_of(12289 * 16);
    for (i = 0; i < hn; i++) {
        FN_DSA_REAL ff =
            fxr_add(fxr_mul(f[i], f[i]), fxr_mul(f[i + hn], f[i + hn]));
        FN_DSA_REAL gg =
            fxr_add(fxr_mul(g[i], g[i]), fxr_mul(g[i + hn], g[i + hn]));
        FN_DSA_REAL norm = fxr_add(ff, gg);
        bad |= fxr_gt(ff, fbound) | fxr_gt(gg, fbound) | fxr_lt(norm, lower) |
               fxr_gt(norm, upper);
    }
    return bad == 0;
}

/* ePrint 2026/1531, Algorithm 2: post-solver bounds on F, G and the root. */
static int fn_dsa_bounds_post(FN_DSA_WORK *wk, int8_t *f, int8_t *g, int8_t *F,
                              int8_t *G, unsigned logn)
{
    size_t mark = wk->used, n = (size_t)1 << logn, hn = n / 2, i;
    unsigned bad = 0;
    FN_DSA_REAL *a = fn_dsa_alloc(wk, 4 * n * sizeof(*a)), *b, *c, *d;
    if (!wk->ok)
        return 0;
    uint64_t norm_fg = 0;
    FN_DSA_REAL orthogonal_norm = fxr_of(0);
    b = a + n;
    c = b + n;
    d = c + n;
    for (i = 0; i < n; i++) {
        norm_fg +=
            (int32_t)f[i] * (int32_t)f[i] + (int32_t)g[i] * (int32_t)g[i];
        a[i] = fxr_of(f[i]);
        b[i] = fxr_of(g[i]);
        c[i] = fxr_of(F[i]);
        d[i] = fxr_of(G[i]);
    }
    fn_dsa_FFT(a, (int32_t)logn);
    fn_dsa_FFT(b, (int32_t)logn);
    fn_dsa_FFT(c, (int32_t)logn);
    fn_dsa_FFT(d, (int32_t)logn);
    bad |= !fn_dsa_bounds_pre(a, b, n);
    for (i = 0; i < hn; i++) {
        FN_DSA_REAL ff =
            fxr_add(fxr_mul(c[i], c[i]), fxr_mul(c[i + hn], c[i + hn]));
        FN_DSA_REAL gg =
            fxr_add(fxr_mul(d[i], d[i]), fxr_mul(d[i + hn], d[i + hn]));
        FN_DSA_REAL den = fxr_add(
            fxr_add(fxr_mul(a[i], a[i]), fxr_mul(a[i + hn], a[i + hn])),
            fxr_add(fxr_mul(b[i], b[i]), fxr_mul(b[i + hn], b[i + hn])));
        FN_DSA_REAL nr = fxr_add(
            fxr_add(fxr_mul(c[i], a[i]), fxr_mul(c[i + hn], a[i + hn])),
            fxr_add(fxr_mul(d[i], b[i]), fxr_mul(d[i + hn], b[i + hn])));
        FN_DSA_REAL ni = fxr_add(
            fxr_sub(fxr_mul(c[i + hn], a[i]), fxr_mul(c[i], a[i + hn])),
            fxr_sub(fxr_mul(d[i + hn], b[i]), fxr_mul(d[i], b[i + hn])));
        orthogonal_norm =
            fxr_add(orthogonal_norm, fxr_div(fxr_of(12289 * 12289), den));
        FN_DSA_REAL kr = fxr_div(nr, den), ki = fxr_div(ni, den);
        bad |=
            fxr_gt(ff, fxr_of(3500 * 3500)) | fxr_gt(gg, fxr_of(3500 * 3500));
        bad |=
            fxr_gt(fxr_add(fxr_mul(kr, kr), fxr_mul(ki, ki)), fxr_of(24 * 24));
    }
    bad |= (norm_fg >= 16823);
    bad |= fxr_ge(fxr_div(orthogonal_norm, fxr_of((int64_t)hn)),
                  fn_dsa_fxp_bnorm_max);
    fn_dsa_release(wk, mark);
    return bad == 0;
}

